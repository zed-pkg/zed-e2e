# zed-e2e environment schema — names and meanings only, never real values.
# Real values live encrypted in env/enc/<name>.env.enc (sops + age).
# Edit with `just edit <name>`; activate with `just use <name>`.
#
# Consumers: harness/stack.ts (the ZED_E2E_* family is read there — see its
# doc-comment) boots postgres + zed-api-server + zed-web-server for every
# suite (Playwright/Puppeteer/Selenium browser suites and the CLI suites).
# With ZED_E2E_STORAGE_BACKEND=s3 the harness passes S3_* / AWS_* through to
# zed-api-server unchanged (arm from PR #20, feat/r2-s3-e2e-enablement).

# --- Harness stack overrides (harness/stack.ts) ------------------------------
# Non-secret port overrides so a local harness run can coexist with the
# `zed-e2e` kind cluster, whose NodePorts publish the stack on the defaults
# (55432/48080/48081). Offset-by-ten pattern; the harness refuses to run on a
# port that is already in use.
ZED_E2E_PG_PORT=55433
ZED_E2E_API_PORT=48090
ZED_E2E_WEB_PORT=48091

# Storage backend for zed-api-server: `local` (default), `memory`, or `s3`.
# `s3` requires S3_BUCKET below and is how the suites run against R2.
ZED_E2E_STORAGE_BACKEND=s3

# Other harness knobs (defaults are fine; uncomment to override):
# ZED_E2E_API_URL=            # point suites at an already-running stack (skips boot)
# ZED_E2E_WEB_URL=
# ZED_E2E_PG_CONTAINER=       # docker container name (default zed-e2e-postgres)
# ZED_E2E_PG_IMAGE=           # pgvector-enabled Postgres image
# ZED_E2E_STORAGE_MEMORY_MAX_BYTES=   # only for ZED_E2E_STORAGE_BACKEND=memory
# ZED_E2E_KEEP=1              # leave the stack up after the run
# ZED_E2E_HOME=               # CLI suites' isolated HOME

# --- R2 (S3 API) — forwarded verbatim to zed-api-server ----------------------
# Bucket name is an identifier, not a secret.
S3_BUCKET=zed-pkg-artifacts-e2e
# Account-scoped R2 endpoint. The embedded Cloudflare account id is an
# identifier (it appears in API URLs), not a secret.
S3_ENDPOINT_URL=EXAMPLE-https://<cloudflare-account-id>.r2.cloudflarestorage.com
# R2 ignores region; the SDK still requires one.
S3_REGION=auto
# R2 requires path-style addressing.
S3_FORCE_PATH_STYLE=true

# R2 S3 credential pair. SECRET — enter via `just edit <name>` ONLY; a key that
# transits chat, a shell command, or a plaintext file is burned and must be
# revoked (see the credential policy / DEN-2836). Note R2 derives the secret
# key as sha256(api_token), and R2 S3 keys are account-wide.
AWS_ACCESS_KEY_ID=EXAMPLE-enter-via-just-edit
AWS_SECRET_ACCESS_KEY=EXAMPLE-rotate-in-dashboard-enter-via-just-edit
